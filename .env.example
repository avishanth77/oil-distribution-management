VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Edge Function environment variables. Configure these in the Supabase
# dashboard under Edge Functions -> manage-staff -> Secrets.
# SUPABASE_SERVICE_ROLE_KEY is a server-side secret and must NEVER be
# prefixed with VITE_ or exposed to the browser.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by
# Supabase. Set ALLOWED_ORIGINS to a comma-separated list of your deployed
# origins, for example:
# ALLOWED_ORIGINS=https://your-app.vercel.app
